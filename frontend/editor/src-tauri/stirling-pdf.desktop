[Desktop Entry]
Version=1.0
Type=Application
Name=纸环 PaperRing
Comment=纸环 PaperRing — local PDF tools. Files stay on this computer.
TryExec={{exec}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
MimeType=application/pdf;
Categories=Office;Graphics;Utility;
Actions=open-file;
StartupWMClass=PaperRing

[Desktop Action open-file]
Name=Open PDF File
Exec={{exec}} %F
